# Required for signing auth cookies in production
AUTH_SECRET=replace-with-a-long-random-secret

# Optional: override the SQLite database path in local/dev environments
# DB_PATH=./data/app.db

# Optional: enables GPT streaming + semantic vector retrieval
# OPENAI_API_KEY=your-openai-key

# Optional: enables Pinecone vector search (requires OPENAI_API_KEY for query embeddings)
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_INDEX=rag
# PINECONE_NAMESPACE=ns1
